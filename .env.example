POMO_HOST=127.0.0.1
POMO_PORT=8000
# Set to false to disable manual previews and simulated input controls.
POMO_DEV_CONTROLS=true
# Browser capture constraints; decoded images must not exceed these dimensions.
POMO_CAMERA_WIDTH=640
POMO_CAMERA_HEIGHT=480
POMO_CAMERA_FPS=10
POMO_CAMERA_JPEG_QUALITY=0.75
POMO_CAMERA_MAX_BYTES=524288
# Deadline for body/decode and idle timeout after a successful frame.
POMO_CAMERA_TIMEOUT_SECONDS=3
# Time to grant browser permission and deliver the first frame.
POMO_CAMERA_STARTUP_SECONDS=30
# Optional absolute path; default is models/face_landmarker.task in this repo.
# POMO_CAMERA_MODEL_PATH=/absolute/path/to/face_landmarker.task
# Sustained-absence policy (seconds); grace must not exceed absence duration.
POMO_TRACKING_LOSS_GRACE_SECONDS=1
POMO_ABSENCE_SECONDS=5
# Minimum quiet interval after a reminder; dismissal restarts a full cooldown.
POMO_REMINDER_COOLDOWN_SECONDS=30
# Freshness limit for normalized/simulated observation input.
POMO_OBSERVATION_TIMEOUT_SECONDS=3
# Sound is off by default; a browser gesture is also needed to unlock audio.
POMO_SOUND_ENABLED=false
POMO_RETURN_SECONDS=0.5
POMO_OBSERVATION_MAX_AGE_SECONDS=1
# MediaPipe thresholds (not per-frame confidence scores).
POMO_PERCEPTION_DETECTION_CONFIDENCE=0.5
POMO_PERCEPTION_PRESENCE_CONFIDENCE=0.5
POMO_PERCEPTION_TRACKING_CONFIDENCE=0.5
# Grayscale mean 0–255 and Laplacian variance; heuristics need camera tuning.
POMO_PERCEPTION_MIN_BRIGHTNESS=35
POMO_PERCEPTION_MAX_BRIGHTNESS=230
# Blur rejection uses a low threshold; tune against physical camera observations.
POMO_PERCEPTION_MIN_BLUR_VARIANCE=5
# Automatic head direction relative to the camera.
POMO_PERCEPTION_YAW_DEGREES=30
POMO_PERCEPTION_PITCH_DEGREES=25
POMO_PERCEPTION_HYSTERESIS_DEGREES=5
# Coarse iris direction: normalized distance from each eye's midpoint.
POMO_PERCEPTION_EYE_HORIZONTAL_MARGIN=0.15
# Signed iris displacement from the eye-corner line, as a fraction of eye width.
POMO_PERCEPTION_EYE_VERTICAL_OFFSET_THRESHOLD=0.08
POMO_PERCEPTION_EYE_BLINK_THRESHOLD=0.55
# Raw model coefficient mapped continuously to a displayed full-closure score of 1.00.
POMO_PERCEPTION_EYE_BLINK_FULL_CLOSURE=0.60
# Beyond these head angles, iris direction is unknown.
POMO_PERCEPTION_EYE_MAX_YAW_DEGREES=60
POMO_PERCEPTION_EYE_MAX_PITCH_DEGREES=45
# Vertical eye-look coefficients supplement iris geometry when eyelids follow the iris.
POMO_PERCEPTION_EYE_VERTICAL_SIGNAL_THRESHOLD=0.30
POMO_PERCEPTION_EYE_VERTICAL_SIGNAL_MARGIN=0.10
