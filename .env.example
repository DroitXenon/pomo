POMO_HOST=127.0.0.1
POMO_PORT=8000
# Set to false to disable simulated observations and manual expression previews.
POMO_DEV_CONTROLS=true
# Sustained absence before the first visual reminder (seconds, greater than 0).
POMO_ABSENCE_SECONDS=5
# Quiet period after a trigger or dismissal (seconds, 0 permits immediate repeats).
POMO_REMINDER_COOLDOWN_SECONDS=30
# Observations must arrive more frequently than this timeout (seconds, > 0).
POMO_OBSERVATION_TIMEOUT_SECONDS=3
# Optional browser sound; each browser still requires a user gesture to allow audio.
POMO_SOUND_ENABLED=false
